{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "frontend-design@claude-code-plugins": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run design:*)",
      "Bash(node scripts/design-check.mjs:*)",
      "Bash(node scripts/design-sweep.mjs:*)",
      "Bash(bash scripts/preview-clone.sh:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/design-check.mjs\" --hook",
            "timeout": 20,
            "statusMessage": "design:lint"
          }
        ]
      }
    ]
  }
}
